{
  "name": "@mediago/project",
  "version": "0.1.0",
  "description": "A powerful and easy-to-use online video downloader",
  "author": "caorushizi",
  "homepage": "https://downloader.caorushizi.cn/",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "knip": "knip",
    "dev:electron": "task dev:electron",
    "dev:electron:raw": "pnpm start:electron",
    "start:electron": "cross-env APP_TARGET=electron turbo run dev -F @mediago/electron -F @mediago/ui",
    "build:electron": "task build:electron",
    "build:electron:raw": "cross-env APP_TARGET=electron NODE_ENV=production turbo run build -F @mediago/electron -F @mediago/ui -F @mediago/extension",
    "dev:web": "task dev:web",
    "dev:server": "task dev:web",
    "dev:web:raw": "cross-env APP_TARGET=server NODE_ENV=development turbo run dev -F @mediago/server -F @mediago/ui",
    "build:web": "task build:web",
    "build:web:raw": "cross-env APP_TARGET=server NODE_ENV=production turbo run build -F @mediago/ui",
    "build:server": "task build:server",
    "build:server:raw": "cross-env APP_TARGET=server NODE_ENV=production turbo run build -F @mediago/server -F @mediago/ui",
    "dev:extension": "task dev:extension",
    "dev:extension:raw": "pnpm -F @mediago/extension run dev",
    "build:extension": "task build:extension",
    "build:extension:raw": "pnpm -F @mediago/extension run build",
    "dev:all": "task dev:all",
    "dev:all:raw": "concurrently --kill-others-on-fail --names backend,electron-ui,server-ui \"cross-env APP_TARGET=electron turbo run dev -F @mediago/server -F @mediago/electron\" \"cross-env APP_TARGET=electron pnpm -F @mediago/ui run dev\" \"cross-env APP_TARGET=server pnpm -F @mediago/ui run dev\"",
    "pack:extension": "task pack:extension",
    "pack:extension:raw": "pnpm exec tsx scripts/pack-extension.ts",
    "icons:electron": "tsx scripts/generate-electron-icons.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "task check",
    "check:raw": "pnpm lint && pnpm format:check && pnpm type:check",
    "test": "task test",
    "test:raw": "pnpm test:ts && pnpm test:go",
    "test:ts": "vitest run",
    "test:ts:raw": "vitest run",
    "test:watch": "vitest",
    "test:go": "cd apps/core && go test ./...",
    "test:go:raw": "cd apps/core && go test ./...",
    "test:unit": "task test",
    "test:integration:media:setup": "task deps:media-integration",
    "test:integration:media:run": "task test:integration",
    "test:integration:media:run:raw": "vitest run --config vitest.integration.config.ts",
    "test:integration:media": "task test:integration",
    "test:integration": "task test:integration",
    "test:integration:raw": "pnpm test:integration:media:run:raw",
    "test:e2e:setup:deps": "tsx scripts/download-deps.ts --tools aria2",
    "test:e2e:setup:browser": "playwright install chromium",
    "test:e2e:setup": "pnpm test:e2e:setup:deps && pnpm test:e2e:setup:browser",
    "test:e2e:build:core": "cd apps/core && go build -o bin/mediago-core ./cmd/server",
    "test:e2e:build": "pnpm test:e2e:build:core && pnpm test:e2e:build:raw",
    "test:e2e:build:raw": "cross-env APP_TARGET=electron NODE_ENV=production turbo run build -F @mediago/server -F @mediago/electron -F @mediago/electron-preload -F @mediago/extension",
    "test:e2e": "task test:e2e",
    "test:e2e:raw": "playwright test",
    "test:e2e:web": "task test:e2e:web",
    "test:e2e:web:raw": "playwright test --project=web",
    "test:e2e:electron": "task test:e2e:electron",
    "test:e2e:electron:raw": "playwright test --project=electron",
    "test:e2e:extension": "task test:e2e:extension",
    "test:e2e:extension:raw": "playwright test --project=extension",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage:ts": "vitest run --coverage",
    "test:coverage:go": "node --input-type=module --eval \"import fs from 'node:fs'; fs.rmSync('coverage/go', { recursive: true, force: true }); fs.mkdirSync('coverage/go', { recursive: true });\" && cd apps/core && go test -coverprofile=../../coverage/go/coverage.out ./...",
    "test:coverage": "node --input-type=module --eval \"import fs from 'node:fs'; fs.rmSync('coverage', { recursive: true, force: true });\" && pnpm test:coverage:ts && pnpm test:coverage:go",
    "test:ci": "task test",
    "pack:electron": "task pack:electron",
    "pack:electron:raw": "pnpm -F @mediago/electron run pack",
    "release:electron": "task release:electron",
    "release:electron:raw": "pnpm -F @mediago/electron run release",
    "build:docker": "task build:docker",
    "build:docker:raw": "docker build -t mediago:local .",
    "docs:dev": "task docs:dev",
    "docs:dev:raw": "pnpm -F @mediago/docs run docs:dev",
    "docs:build": "task build:docs",
    "docs:build:raw": "pnpm -F @mediago/docs run docs:build",
    "type:check": "turbo type:check && pnpm type:check:ci && pnpm type:check:integration",
    "type:check:ci": "tsc -p tsconfig.ci.json",
    "type:check:integration": "tsc -p tsconfig.integration.json",
    "type:check:e2e": "tsc -p tsconfig.e2e.json",
    "core:dev": "pnpm --filter @mediago/core-build run dev",
    "core:build": "pnpm --filter @mediago/core-build run build",
    "player:dev": "pnpm --filter @mediago/core-build run dev",
    "player:build": "pnpm --filter @mediago/core-build run build",
    "deps:download": "task deps:runtime",
    "deps:download:raw": "tsx scripts/download-deps.ts",
    "deps:download:all": "tsx scripts/download-deps.ts --all",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,css,md,html,yml,yaml}": [
      "oxfmt --write"
    ]
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.9.2",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "dotenv-flow": "4.1.0",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "knip": "^6.1.1",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.57.0",
    "playwright": "1.61.1",
    "sharp": "0.35.3",
    "tsx": "^4.20.6",
    "turbo": "^2.9.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2",
    "yaml": "2.8.3"
  }
}
