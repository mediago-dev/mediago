{
  "name": "@mediago/electron",
  "version": "0.1.0",
  "type": "module",
  "main": "main/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsdown --watch ./src",
    "build": "cross-env NODE_ENV=production tsdown",
    "pack": "cross-env NODE_ENV=production tsx ../../packages/tooling/src/electron/build.ts --dir",
    "release": "cross-env NODE_ENV=production tsx ../../packages/tooling/src/electron/build.ts",
    "icons": "tsx ../../packages/tooling/src/electron/generate-icons.ts",
    "clean": "rimraf app/build && rimraf release",
    "lint": "oxlint .",
    "type:check": "tsc --noEmit"
  },
  "author": "caorushizi",
  "license": "MIT",
  "devDependencies": {
    "@mediago/tooling": "workspace:*",
    "@types/lodash": "^4.17.25",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.3.0",
    "cross-env": "^10.1.0",
    "electron": "44.0.0",
    "electron-builder-squirrel-windows": "26.15.3",
    "electron-updater": "^6.8.9",
    "glob": "^13.0.6",
    "rimraf": "^6.1.3",
    "rollup-plugin-copy": "^3.5.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.18.2",
    "@ghostery/adblocker-electron-preload": "^2.18.2",
    "@inversifyjs/binding-decorators": "^3.0.0",
    "@mediago/browser-extension": "workspace:*",
    "@mediago/core-sdk": "workspace:*",
    "@mediago/electron-preload": "workspace:*",
    "@mediago/service-runner": "workspace:*",
    "@mediago/common": "workspace:*",
    "axios": "^1.19.0",
    "dayjs": "^1.11.23",
    "electron-devtools-installer": "^4.0.0",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "i18next": "^26.4.0",
    "inversify": "^8.2.3",
    "lodash": "^4.18.1",
    "lru-cache": "^11.5.2",
    "mime-types": "^3.0.2",
    "nanoid": "^6.0.1",
    "reflect-metadata": "^0.2.2"
  }
}
