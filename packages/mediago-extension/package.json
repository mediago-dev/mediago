{
  "name": "@mediago/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser extension that sniffs downloadable video resources and sends them to a MediaGo server (Desktop or Docker).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "pack": "tsx ../tooling/src/extension/pack.ts",
    "verify:build-artifacts": "node ../tooling/src/extension/verify-build-artifacts.ts",
    "lint": "oxlint .",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@mediago/browser-extension": "workspace:*",
    "@mediago/common": "workspace:*",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@mediago/tooling": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "~8.2.4"
  }
}
