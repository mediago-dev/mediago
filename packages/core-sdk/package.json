  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "pnpm --dir ../.. exec vitest run packages/core-sdk",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/node": "^26.3.0",
    "bumpp": "^12.2.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "~4.1.12"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "eventsource": "^5.1.3",
    "mitt": "^3.0.1"
  }
